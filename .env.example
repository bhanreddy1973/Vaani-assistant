# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Sarvam AI — get your subscription key at https://dashboard.sarvam.ai/admin
SARVAM_API_KEY=

# Sarvam Voice Agent id (create the agent in the Sarvam dashboard, then paste its id here)
SARVAM_VOICE_AGENT_ID=

# Base URL of this app once deployed (used for callback/tool URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
